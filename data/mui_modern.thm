<theme>
	<!--
	Exult themed menu style "modern": flat dark panels, a blue accent and
	sans-serif type. Metrics are in pixels at a 720-px display height and
	scale with the display. Colours are #RRGGBB and resolve to the nearest
	day-palette entry. Missing keys in other themes fall back to these values.
	-->
	<meta>
		<name>modern</name>
		<label>0xC02</label>
	</meta>
	<layout>
		<tabs>left</tabs>
		<sidebar_width>200</sidebar_width>
	</layout>
	<metrics>
		<unit>8</unit>
		<gap>8</gap>
		<control_h>32</control_h>
		<row_h>44</row_h>
		<tab_h>40</tab_h>
		<radius>6</radius>
		<border>1</border>
		<title_h>48</title_h>
		<footer_h>52</footer_h>
	</metrics>
	<colours>
		<backdrop>#000000</backdrop>
		<backdrop_alpha>170</backdrop_alpha>
		<window>#161a20</window>
		<panel>#232a35</panel>
		<panel_alt>#2c3442</panel_alt>
		<frame>#3a4352</frame>
		<frame_light>#4b5566</frame_light>
		<frame_dark>#11151b</frame_dark>
		<text>#e6e9ef</text>
		<text_dim>#9aa3b2</text_dim>
		<text_on_accent>#ffffff</text_on_accent>
		<text_on_danger>#ffffff</text_on_danger>
		<title_text>#e6e9ef</title_text>
		<accent>#3d7eff</accent>
		<accent_hover>#5a92ff</accent_hover>
		<focus>#8fb4ff</focus>
		<danger>#e0483e</danger>
		<warning>#e0a030</warning>
		<success>#3fb06a</success>
		<badge_now>#3fb06a</badge_now>
		<badge_restart>#e0a030</badge_restart>
		<badge_changed>#3d7eff</badge_changed>
		<cheat_accent>#e0483e</cheat_accent>
	</colours>
	<fonts>
		<title>
			<face>sans_bold</face>
			<px>24</px>
		</title>
		<heading>
			<face>sans_bold</face>
			<px>16</px>
		</heading>
		<body>
			<face>sans</face>
			<px>16</px>
		</body>
		<small>
			<face>sans</face>
			<px>13</px>
		</small>
		<mono>
			<face>sans</face>
			<px>13</px>
		</mono>
	</fonts>
	<frame>
		<style>flat</style>
	</frame>
	<panel>
		<texture>none</texture>
	</panel>
</theme>
