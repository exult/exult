<theme>
	<!--
	Exult themed menu style "ultima": parchment panels in a stone frame with
	gold accents and serif type. Metrics are in pixels at a 720-px display
	height and scale with the display. Colours are #RRGGBB and resolve to the
	nearest day-palette entry. A mod can override this file with
	mui_themes/ultima.thm in its patch folder or add new themes there.
	-->
	<meta>
		<name>ultima</name>
		<label>0xC01</label>
	</meta>
	<layout>
		<tabs>top</tabs>
		<sidebar_width>200</sidebar_width>
	</layout>
	<metrics>
		<unit>8</unit>
		<gap>8</gap>
		<control_h>32</control_h>
		<row_h>44</row_h>
		<tab_h>36</tab_h>
		<radius>0</radius>
		<border>3</border>
		<title_h>48</title_h>
		<footer_h>52</footer_h>
	</metrics>
	<colours>
		<backdrop>#000000</backdrop>
		<backdrop_alpha>150</backdrop_alpha>
		<window>#4a443b</window>
		<panel>#dacab2</panel>
		<panel_alt>#cab291</panel_alt>
		<frame>#6b6458</frame>
		<frame_light>#9a9284</frame_light>
		<frame_dark>#2e2a25</frame_dark>
		<text>#2b1d0e</text>
		<text_dim>#6e5a3c</text_dim>
		<text_on_accent>#2b1d0e</text_on_accent>
		<text_on_danger>#f0dc9c</text_on_danger>
		<title_text>#f0dc9c</title_text>
		<accent>#c9a227</accent>
		<accent_hover>#e0bb40</accent_hover>
		<focus>#8a2a0e</focus>
		<danger>#9c2414</danger>
		<warning>#b8740c</warning>
		<success>#3f6e22</success>
		<badge_now>#3f6e22</badge_now>
		<badge_restart>#b8740c</badge_restart>
		<badge_changed>#2e5590</badge_changed>
		<cheat_accent>#b02018</cheat_accent>
	</colours>
	<fonts>
		<title>
			<face>serif_bold</face>
			<px>30</px>
		</title>
		<heading>
			<face>serif_bold</face>
			<px>20</px>
		</heading>
		<body>
			<face>serif</face>
			<px>16</px>
		</body>
		<small>
			<face>serif</face>
			<px>13</px>
		</small>
		<mono>
			<face>sans</face>
			<px>16</px>
		</mono>
	</fonts>
	<frame>
		<style>stone</style>
	</frame>
	<panel>
		<texture>parchment</texture>
	</panel>
</theme>
